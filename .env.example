# Copy to .env for local development. Do not commit the populated file.
# Production secrets belong in your deployment's secret manager.
APP_ORIGIN=http://localhost:3000
# Neon pooled application URL. Retain Neon's TLS verification parameters.
DATABASE_URL=
# Separate, restricted direct Neon connection used only for migrations/seeding.
DATABASE_MIGRATION_URL=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
BETTER_AUTH_SECRET=
# Generate independently with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Exactly 32 random bytes in base64; encrypts queued email bodies. Retain securely.
APP_ENCRYPTION_KEY=
RESEND_API_KEY=
# A verified sender from your Resend account.
EMAIL_FROM=
NEXT_TELEMETRY_DISABLED=1

# Optional private documents. Uploads remain disabled until S3 + ClamAV are configured.
# See docs/DOCUMENTS.md. No NEXT_PUBLIC_ prefix on any storage credential.
DOCUMENT_S3_BUCKET=
DOCUMENT_S3_REGION=
# Empty for AWS S3; HTTPS endpoint for S3-compatible storage.
DOCUMENT_S3_ENDPOINT=
DOCUMENT_S3_PATH_STYLE=false
# Standard AWS credential chain also supports server/workload roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional temporary credential session token.
AWS_SESSION_TOKEN=
# Trusted private ClamAV service; never expose this port publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
